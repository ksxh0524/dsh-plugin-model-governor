# 工作区同源钩子——唯一真源是索引仓根 .husky，各仓原样复制（逐字节一致即算标准）。
# 形态分流只此一处：docs/check.mjs 存在 = 索引仓（文档门），否则 = 代码仓（类型门）。
# 其余各行无条件执行，该炸就炸，不静默跳过。
# 密钥扫描：gitleaks v8.18+ 推荐的 pre-commit 写法（本机 brew 安装；无 CLI 的机器跳过，不假故障）。
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact || exit 1
fi

# 暂存文件格式化：prettier --write 并自动重新暂存（各仓 lint-staged 配各仓规则）。
pnpm exec lint-staged || exit 1

if [ -f docs/check.mjs ]; then
  # 索引仓：文档门（L0 预算/链接/登记/编号；零依赖 `node docs/check.mjs`）。
  node docs/check.mjs || exit 1
else
  # 代码仓：类型检查 + 标准门（dsh-check 注册件存在即跑，不存在只跑类型；
  # 全量业务测试留给 pre-push/CI，commit 只拦"标准红灯不过夜"）。
  pnpm typecheck || exit 1
  if [ -f tests/standard.test.ts ]; then
    node --test tests/standard.test.ts || exit 1
  fi
fi
